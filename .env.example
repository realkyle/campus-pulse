# Copy to backend/.env and fill in your values.
OPENAI_API_KEY=sk-...

# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Optional: enables admin-only demo alerts (see api/demo.md). Generate with: openssl rand -hex 32
# Leave unset to turn demo alerts off.
DEMO_ADMIN_TOKEN=
