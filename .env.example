# Copy to backend/.env and fill in your values.
OPENAI_API_KEY=sk-...

# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Auth0: verifies access tokens for /api/recommendations and /api/interactions
# (see auth0/README.md). If unset, those two endpoints return 503.
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_AUDIENCE=https://campus-pulse-api

# Demo alerts (optional) — admin-only fake alerts, see api/demo.md
# Generate with: openssl rand -hex 32. Leave empty to turn demo alerts off.
DEMO_ADMIN_TOKEN=
