# Auth0 (Regular Web Application in your Auth0 tenant)
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_AUTH0_CLIENT_SECRET
# Encrypts the session cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Only @uw.edu / @washington.edu accounts are accepted (Auth0 post-login Action
# in auth0/actions/, plus a safety-net check in lib/auth0.ts).

# Backend API (defaults to the production backend if unset)
NEXT_PUBLIC_API_URL=http://localhost:8000
